"""Integration tests for configuration loading, using real files on disk."""

import re
from pathlib import Path

import pytest

from {{ package_name }}.settings import (
    LoggingSettings,
    LogLevel,
    Settings,
    load_settings,
)

pytestmark = pytest.mark.integration

# Each source sets a distinct level, so the winner is visible in the result.
SOURCES: dict[str, LogLevel] = {
    "constructor": "CRITICAL",
    "environment": "ERROR",
    "dotenv": "WARNING",
    "defaults": "INFO",
}


def test_committed_env_example_matches_the_settings_model(
    supported_keys: set[str],
) -> None:
    """The example lists every supported field and contains no obsolete keys."""
    example = Path(__file__).resolve().parents[1] / ".env.example"
    actual = set()
    for raw in example.read_text(encoding="utf-8").splitlines():
        # Commented-out keys count: they document optional fields.
        key = raw.strip().lstrip("#").strip().split("=", 1)
        if len(key) == 2 and re.fullmatch(r"[A-Z][A-Z0-9_]*", key[0].strip()):
            actual.add(key[0].strip())

    assert actual == supported_keys
    load_settings(env_file=example)


@pytest.mark.parametrize("source", SOURCES)
def test_source_precedence(
    source: str, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Each source wins over all sources below it in the documented order."""
    # Set the value in this source and in every source ranked below it.
    names = list(SOURCES)
    active = names[names.index(source) :]
    env_file = tmp_path / "selected.env"
    env_file.write_text("", encoding="utf-8")
    if "environment" in active:
        monkeypatch.setenv("LOGGING__LEVEL", SOURCES["environment"])
    if "dotenv" in active:
        env_file.write_text(f"LOGGING__LEVEL={SOURCES['dotenv']}\n", encoding="utf-8")

    if source == "constructor":
        settings = Settings(
            logging=LoggingSettings(level=SOURCES["constructor"]), _env_file=env_file
        )
    else:
        settings = load_settings(env_file=env_file)

    assert settings.logging.level == SOURCES[source]


def test_no_files_are_discovered_automatically(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """No `.env` file in the working directory is ever read."""
    monkeypatch.chdir(tmp_path)
    for name in (".env", ".env.local"):
        (tmp_path / name).write_text("LOGGING__FORMAT=invalid\n", encoding="utf-8")

    assert load_settings().logging.format == "text"


def test_explicit_paths_work_outside_the_checkout(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Absolute and relative dotenv paths both resolve from the working directory."""
    env_file = tmp_path / "selected.env"
    env_file.write_text("LOGGING__LEVEL=DEBUG\n", encoding="utf-8")
    elsewhere = tmp_path / "elsewhere"
    elsewhere.mkdir()
    monkeypatch.chdir(elsewhere)

    assert load_settings(env_file=env_file).logging.level == "DEBUG"
    assert load_settings(env_file=Path("../selected.env")).logging.level == "DEBUG"


def test_a_missing_env_file_fails(tmp_path: Path) -> None:
    """A selected dotenv file that does not exist is an error."""
    with pytest.raises(FileNotFoundError, match="absent"):
        load_settings(env_file=tmp_path / "absent")
