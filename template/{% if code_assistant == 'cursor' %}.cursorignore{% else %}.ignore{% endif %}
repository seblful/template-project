# Paths that assistants and fast search tools (ripgrep, fd) should not read or index.
# Mirrors .gitignore, plus the env files that .gitignore keeps local but that must
# also stay out of an assistant's context.

# Python
__pycache__/
*.py[cod]
*.so

# Packaging
build/
dist/
*.egg-info/

# Virtual environments
.venv/

# Environments — real values live here
.env
.env.*
!.env.example

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.hypothesis/

# Caches
.ruff_cache/
.ty_cache/
.mypy_cache/

# Logs
logs/
*.log

# Docs output
site/

# Jupyter
.ipynb_checkpoints/

# Database
*.db
*.sqlite
*.sqlite3

# Secrets
*.key
*.pem
secrets/
credentials/
.ssh/

# Lockfile: large, generated, and never worth reading in full
uv.lock

# OS
.DS_Store
Thumbs.db
