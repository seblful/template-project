# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# Real .env* files are gitignored; this example is committed as the config contract.

# Application Settings
APP__APP_NAME={{ project_slug }}
APP__ENVIRONMENT=development
# Example secret — uncomment and set a real value (never commit it):
# APP__SECRET_KEY=change-me

# Logging Settings
LOGGING__FILE_LEVEL=DEBUG
LOGGING__CONSOLE_LEVEL=INFO
