# The config contract: every key the application reads, with safe placeholder values.
# This file is committed — never put a real secret in it. A test fails if a key here
# stops matching a field on the settings model, so keep the two in step.
#
# A gitignored .env was generated alongside this file for local development; edit that
# one. Personal overrides that should never be shared go in .env.local.
# Deployed environments set real environment variables instead of shipping .env files.

# Application Settings
APP__APP_NAME={{ project_slug }}
# development | staging | production — normally set by the shell, Dockerfile or CI.
APP__ENVIRONMENT=development
# Example secret — set a real value in .env or the deployment environment, never here:
# APP__SECRET_KEY=change-me

# Logging Settings
LOGGING__FILE_LEVEL=INFO
LOGGING__CONSOLE_LEVEL=INFO
# LOGGING__LOG_FILE=logs/app.log
