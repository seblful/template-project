# Every key the application reads, with safe placeholder values. Committed — never
# put a real secret in it. Copy this to a gitignored .env and select it explicitly
# with load_settings(env_file=Path(".env")) or the CLI's --env-file option.

# Application Settings
APP__APP_NAME={{ project_slug }}
# development | staging | production — normally set by the shell, Dockerfile or CI.
APP__ENVIRONMENT=development
# Example secret — set a real value in .env or the deployment environment, never here:
# APP__SECRET_KEY=change-me

# Logging Settings
LOGGING__FILE_LEVEL=INFO
LOGGING__CONSOLE_LEVEL=INFO
# LOGGING__LOG_FILE=logs/app.log
