{
  "$comment": "Committed: project-scoped rules only. Machine-local overrides go in .claude/settings.local.json, which is gitignored.",
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(git *)",
      "Bash(ruff *)",
      "Bash(pre-commit *)",
      "Bash(ty *)",
      "Bash(pytest *)",
      "Bash(mdformat *)",
      "Bash(mkdocs *)",
      "Read(.env.example)"
    ],
    "$comment": "Enumerated, not .env.*: that glob would also block the committed .env.example. Add any new .env.<name> here, or it stays readable.",
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(uv publish)",
      "Bash(uv publish *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.dev)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(.env.prod)",
      "Read(.env.test)",
      "Read(.env.ci)",
      "Read(secrets/**)",
      "Read(credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
