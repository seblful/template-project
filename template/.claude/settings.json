{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(git *)",
      "Bash(ruff *)",
      "Bash(pre-commit *)",
      "Bash(ty *)"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(git push --force *)"]
  },
  "skillListingBudgetFraction": 0.02,
  "statusLine": {
    "type": "command",
    "command": "jq -r '(.context_window.used_percentage // 0) as $pct | (.cost.total_cost_usd // 0) as $cost | (.effort.level // \"?\") as $effort | \"[\\(.model.id)] | \\($effort) | \\($pct)% | $\\(($cost * 1000 | round | . / 1000))\"'"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "for cmd in uv uvx git pre-commit ruff ty pytest mdformat; do command -v $cmd >/dev/null 2>&1 || echo \"⚠️ '$cmd' not found — run uv sync\"; done"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.py) ruff format \"$f\" 2>/dev/null && ruff check --fix --silent \"$f\" 2>/dev/null ;; esac; true",
            "statusMessage": "Formatting Python..."
          },
          {
            "type": "command",
            "command": "f=$(jq -r '.tool_input.file_path // empty'); case \"$f\" in *.md) mdformat \"$f\" 2>/dev/null ;; esac; true",
            "statusMessage": "Formatting Markdown..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "ty check || exit 2",
            "statusMessage": "Running ty type check..."
          },
          {
            "type": "command",
            "command": "echo \"Consider running pytest on the corresponding tests for any files\"",
            "statusMessage": "pytest reminder"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "pydantic-ai@claude-plugins-official": true,
    "code-review@seblful-claude-plugins": true,
    "refactoring@seblful-claude-plugins": true,
    "python-plugin@seblful-claude-plugins": true,
    "lenses@seblful-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "seblful-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "seblful/seblful-claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "cleanupPeriodDays": 90,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
