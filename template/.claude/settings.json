{
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(make *)",
      "Bash(git *)",
      "Bash(ruff *)",
      "Bash(pre-commit *)",
      "Bash(ty *)"
    ],
    "deny": ["Bash(rm -rf *)", "Bash(git push --force *)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run ruff format . && uv run ruff check . --fix --silent"
          },
          {
            "type": "command",
            "command": "uv run mdformat . 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "uv run ty check src/ tests/ 2>/dev/null || true"
          },
          {
            "type": "command",
            "command": "uv run pytest -q 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "jq -r '(.context_window.used_percentage // 0) as $pct | (.cost.total_cost_usd // 0) as $cost | (.effort.level // \"?\") as $effort | \"[\\(.model.id)] | \\($effort) | \\($pct)% | $\\(($cost * 1000 | round | . / 1000))\"'"
  },
  "enabledPlugins": {
    "skill-creator@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "context7@claude-plugins-official": true,
    "obsidian@obsidian-skills": true,
    "github@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "gitlab@claude-plugins-official": true,
    "pydantic-ai@claude-plugins-official": true,
    "code-review@seblful-claude-plugins": true,
    "refactoring@seblful-claude-plugins": true,
    "python-skills@seblful-claude-plugins": true
  },
  "extraKnownMarketplaces": {
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      },
      "autoUpdate": true
    },
    "seblful-claude-plugins": {
      "source": {
        "source": "github",
        "repo": "seblful/seblful-claude-plugins"
      },
      "autoUpdate": true
    }
  },
  "effortLevel": "medium",
  "autoUpdatesChannel": "latest",
  "cleanupPeriodDays": 90,
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "theme": "auto",
  "skipAutoPermissionPrompt": true
}
