{
  "$comment": "Committed and shared with everyone who clones this repo, so it holds only project-scoped rules. Personal preferences (marketplaces, plugins, default permission mode, proxies) belong in ~/.claude/settings.json; machine-local overrides go in .claude/settings.local.json, which is gitignored.",
  "permissions": {
    "allow": [
      "Bash(uv *)",
      "Bash(uvx *)",
      "Bash(git *)",
      "Bash(ruff *)",
      "Bash(pre-commit *)",
      "Bash(ty *)",
      "Bash(pytest *)",
      "Bash(mdformat *)",
      "Bash(mkdocs *)",
      "Read(.env.example)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(uv publish)",
      "Bash(uv publish *)",
      "Read(.env)",
      "Read(.env.local)",
      "Read(.env.development)",
      "Read(.env.staging)",
      "Read(.env.production)",
      "Read(secrets/**)",
      "Read(credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
