from {{ package_name }}.settings import LoggingSettings, Settings, load_settings

pytestmark = pytest.mark.integration


def _supported_keys() -> set[str]:
    """Return every variable name the model reads, groups expanded to their fields."""
    keys = set()
    for name, field in Settings.model_fields.items():
        group = field.annotation
        if isinstance(group, type) and issubclass(group, BaseModel):
            keys.update(f"{name}__{nested}" for nested in group.model_fields)
        else:
            keys.add(name)
    return {key.upper() for key in keys}


def _example(name: str) -> Path:
    """Return a committed example file from the project root."""
    return Path(__file__).resolve().parents[1] / name


def test_committed_env_example_matches_the_settings_model() -> None:
    """The example lists every supported field and contains no obsolete keys."""
    example = _example(".env.example")
    actual = set()
    for raw in example.read_text(encoding="utf-8").splitlines():
        # Commented-out keys count: they document optional fields.
        key = raw.strip().lstrip("#").strip().split("=", 1)
        if len(key) == 2 and re.fullmatch(r"[A-Z][A-Z0-9_]*", key[0].strip()):
            actual.add(key[0].strip())

    assert actual == _supported_keys()
    load_settings(env_file=example)
{%- if config_file %}


def test_committed_config_example_matches_the_settings_model() -> None:
    """The TOML example covers the same keys as `.env.example`, one table per group."""
    example = _example("config.example.toml")
    actual = set()
    table = ""
    for raw in example.read_text(encoding="utf-8").splitlines():
        # Commented-out keys count: they document optional fields.
        line = raw.strip().lstrip("#").strip()
        if header := re.fullmatch(r"\[(\w+)\]", line):
            table = header[1]
        elif key := re.match(r"(\w+)\s*=", line):
            actual.add(f"{table}__{key[1]}".upper() if table else key[1].upper())

    assert actual == _supported_keys()
    load_settings(config_file=example)


