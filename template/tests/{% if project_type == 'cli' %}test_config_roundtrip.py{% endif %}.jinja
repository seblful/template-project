@pytest.mark.parametrize("source", SOURCES)
def test_source_precedence(
    source: str, tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Each source wins over all sources below it in the documented order."""
    # Set the value in this source and in every source ranked below it.
    active = SOURCES[SOURCES.index(source) :]
    key = "LOGGING__LOG_FILE"
    secret_dir = tmp_path / "secrets"
    secret_dir.mkdir()
    env_file = tmp_path / "selected.env"
    env_file.write_text("", encoding="utf-8")
{%- if config_file %}
    config_file = tmp_path / "config.toml"
    config_file.write_text("", encoding="utf-8")
{%- endif %}
    if "environment" in active:
        monkeypatch.setenv(key, "environment")
    if "dotenv" in active:
        env_file.write_text(f"{key}=dotenv\n", encoding="utf-8")
    if "secrets" in active:
        (secret_dir / key).write_text("secrets", encoding="utf-8")
{%- if config_file %}
    if "config" in active:
        config_file.write_text('[logging]\nlog_file = "config"\n', encoding="utf-8")
{%- endif %}

    if source == "constructor":
        settings = Settings(
            logging=LoggingSettings(log_file=Path("constructor")),
            _env_file=env_file,
            _secrets_dir=secret_dir,
        )
    else:
{%- if config_file %}
        settings = load_settings(
            config_file=config_file, env_file=env_file, secrets_dir=secret_dir
        )
{%- else %}
        settings = load_settings(env_file=env_file, secrets_dir=secret_dir)
{%- endif %}

    expected = None if source == "defaults" else Path(source)
    assert settings.logging.log_file == expected
{%- if config_file %}


def test_config_file_merges_with_the_environment(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A variable overrides one field of a group and leaves the file's others."""
    config_file = tmp_path / "config.toml"
    config_file.write_text(
        '[logging]\nconsole_format = "json"\nconsole_level = "DEBUG"\n',
        encoding="utf-8",
    )
    monkeypatch.setenv("LOGGING__CONSOLE_LEVEL", "WARNING")

    settings = load_settings(config_file=config_file)

    assert settings.logging.console_format == "json"
    assert settings.logging.console_level == "WARNING"


@pytest.mark.parametrize(
    ("content", "error", "typo"),
    [
        ('[loging]\nconsole_format = "json"\n', SettingsError, "loging"),
        ('[logging]\nconsole_forma = "json"\n', ValidationError, "console_forma"),
    ],
    ids=["unknown-table", "unknown-field"],
)
def test_config_file_typos_are_rejected(
    tmp_path: Path, content: str, error: type[Exception], typo: str
) -> None:
    """The file belongs to this app alone, so an unknown key at any level fails."""
    config_file = tmp_path / "config.toml"
    config_file.write_text(content, encoding="utf-8")

    with pytest.raises(error, match=typo):
        load_settings(config_file=config_file)
{%- endif %}


def test_nested_secret_files_merge_with_other_sources(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """A secret file sets one field of a group while the environment sets another."""
    secret_dir = tmp_path / "secrets"
    secret_dir.mkdir()
    (secret_dir / "LOGGING__FILE_LEVEL").write_text("DEBUG", encoding="utf-8")
    monkeypatch.setenv("LOGGING__CONSOLE_FORMAT", "json")

    settings = load_settings(secrets_dir=secret_dir)

    assert settings.logging.file_level == "DEBUG"
    assert settings.logging.console_format == "json"


def test_no_files_are_discovered_automatically(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """No `.env`, `config.toml` or `secrets/` in the working directory is ever read."""
    monkeypatch.chdir(tmp_path)
    (tmp_path / "config.toml").write_text(
        '[logging]\nconsole_level = "invalid"\n', encoding="utf-8"
    )
    for name in (".env", ".env.local"):
        (tmp_path / name).write_text(
            "LOGGING__CONSOLE_FORMAT=invalid\n", encoding="utf-8"
        )
    secret_dir = tmp_path / "secrets"
    secret_dir.mkdir()
    (secret_dir / "LOGGING__FILE_LEVEL").write_text("unrequested", encoding="utf-8")

    settings = load_settings()

    assert settings.logging.console_format == "text"
    assert settings.logging.console_level == "INFO"
    assert settings.logging.file_level == "INFO"


def test_explicit_paths_work_outside_the_checkout(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    """Absolute and relative dotenv paths both resolve from the working directory."""
    env_file = tmp_path / "selected.env"
    env_file.write_text("LOGGING__LOG_FILE=from-disk\n", encoding="utf-8")
    elsewhere = tmp_path / "elsewhere"
    elsewhere.mkdir()
    monkeypatch.chdir(elsewhere)

    assert load_settings(env_file=env_file).logging.log_file == Path("from-disk")
    assert load_settings(env_file=Path("../selected.env")).logging.log_file == Path(
        "from-disk"
    )


@pytest.mark.parametrize("option", [{% if config_file %}"config_file", {% endif %}"env_file", "secrets_dir"])
def test_explicit_missing_paths_fail(tmp_path: Path, option: str) -> None:
    """A selected file or secrets directory that does not exist is an error."""
    with pytest.raises(FileNotFoundError, match="absent"):
        load_settings(**{option: tmp_path / "absent"})
