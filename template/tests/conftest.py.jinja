"""Shared pytest fixtures for {{ project_slug }}."""

import os
from collections.abc import Iterator
from pathlib import Path

import pytest

from {{ package_name }} import settings as settings_module
from {{ package_name }}.logging import reset_logging
from {{ package_name }}.settings import Settings, get_settings

# Built from the model rather than listed, so a settings group added later is cleared
# too. Keys are upper-cased first because settings match env vars case-insensitively.
_ENV_PREFIXES = tuple(f"{group.upper()}__" for group in Settings.model_fields)


@pytest.fixture(autouse=True)
def _isolated_settings(
    monkeypatch: pytest.MonkeyPatch, tmp_path: Path
) -> Iterator[None]:
    """Keep the host environment and the developer's own .env out of every test."""
    for key in list(os.environ):
        if key.upper().startswith(_ENV_PREFIXES):
            monkeypatch.delenv(key, raising=False)
    # A path that cannot exist is enough; get_settings() reads this attribute live.
    monkeypatch.setattr(settings_module, "ENV_FILES", (tmp_path / "absent.env",))
    get_settings.cache_clear()
    yield
    get_settings.cache_clear()


@pytest.fixture(autouse=True)
def _isolated_logging() -> Iterator[None]:
    """Detach any handlers a test installed and close the log file it opened."""
    yield
    reset_logging()


@pytest.fixture
def tmp_env_file(tmp_path: Path) -> Path:
    """Create a temporary .env file."""
    env_file = tmp_path / ".env"
    env_file.write_text("APP__ENVIRONMENT=staging\n")
    return env_file


@pytest.fixture
def test_settings(tmp_env_file: Path) -> Settings:
    """Load settings from a temporary env file instead of the project's."""
    return Settings(_env_file=tmp_env_file)
