# Built from the model rather than listed, so a settings group added later is cleared
# too. Keys are upper-cased first because settings match env vars case-insensitively.
_ENV_GROUPS = tuple(group.upper() for group in Settings.model_fields)
_ENV_PREFIXES = tuple(f"{group}__" for group in _ENV_GROUPS)


@pytest.fixture(autouse=True)
def _isolated_settings(monkeypatch: pytest.MonkeyPatch) -> None:
    """Clear both whole-group JSON values and nested environment variables."""
    for key in list(os.environ):
        if key.upper() in _ENV_GROUPS or key.upper().startswith(_ENV_PREFIXES):
            monkeypatch.delenv(key, raising=False)


@pytest.fixture(autouse=True)
def _isolated_logging() -> Iterator[None]:
    """Detach any handlers a test installed and close the log file it opened."""
    yield
    reset_logging()


