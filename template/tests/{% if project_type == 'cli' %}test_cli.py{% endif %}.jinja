def test_cli_loads_an_explicit_config_file(tmp_path: Path) -> None:
    """`--config` reads a TOML file with one table per settings group."""
    config_file = tmp_path / "config.toml"
    config_file.write_text(
        '[logging]\nconsole_format = "json"\nconsole_level = "DEBUG"\n',
        encoding="utf-8",
    )

    result = runner.invoke(app, ["--config", str(config_file), "info"])

    assert result.exit_code == 0, result.output
    assert json.loads(result.stderr)["event"] == "reporting project info"
{%- endif %}


@pytest.mark.parametrize("option", [{% if config_file %}"--config", {% endif %}"--env-file", "--secrets-dir"])
def test_cli_rejects_missing_config_paths(tmp_path: Path, option: str) -> None:
    """A missing path is a usage error, reported before any command runs."""
    result = runner.invoke(app, [option, str(tmp_path / "absent"), "info"])

    assert result.exit_code == 2


@pytest.mark.parametrize("args", [["--version"], ["info", "--help"]])
def test_version_and_help_do_not_load_settings(
    args: list[str], monkeypatch: pytest.MonkeyPatch
) -> None:
    """Invalid configuration cannot break `--version` or a subcommand's `--help`."""
    monkeypatch.setenv("LOGGING__CONSOLE_FORMAT", "invalid")

    result = runner.invoke(app, args)

    assert result.exit_code == 0, result.output
