"""End-to-end tests for the CLI."""

import json
import subprocess
import sys
from pathlib import Path

import pytest
from typer.testing import CliRunner

from {{ package_name }} import __version__
from {{ package_name }}.cli import app
from {{ package_name }}.logging import reset_logging

runner = CliRunner()


def test_info_command_succeeds(tmp_path: Path, monkeypatch: pytest.MonkeyPatch) -> None:
    """`info` exits cleanly and prints the application name."""
    monkeypatch.chdir(tmp_path)  # Keep the generated logs/ out of the repo.
    result = runner.invoke(app, ["info"])

    assert result.exit_code == 0
    assert "{{ project_slug }}" in result.output


def test_version_flag_works_without_a_subcommand() -> None:
    """`--version` does not trip over no_args_is_help or "Missing command"."""
    result = runner.invoke(app, ["--version"])

    assert result.exit_code == 0
    assert __version__ in result.output


def test_bare_invocation_shows_help() -> None:
    """No arguments prints help rather than failing."""
    result = runner.invoke(app, [])

    assert "Usage:" in result.output


def test_module_is_executable(tmp_path: Path) -> None:
    """`python -m {{ package_name }}` is a working entry point."""
    result = subprocess.run(
        [sys.executable, "-m", "{{ package_name }}", "--version"],
        capture_output=True,
        text=True,
        cwd=tmp_path,
        check=False,
    )

    assert result.returncode == 0, result.stderr
    assert __version__ in result.stdout


def test_cli_loads_an_explicit_file_for_each_invocation(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.chdir(tmp_path)
    env_file = tmp_path / "selected.env"
    env_file.write_text(
        "LOGGING__CONSOLE_FORMAT=json\nLOGGING__CONSOLE_LEVEL=DEBUG\n", encoding="utf-8"
    )
    (tmp_path / ".env").write_text(
        "LOGGING__CONSOLE_FORMAT=invalid\n", encoding="utf-8"
    )

    assert runner.invoke(app, ["info"]).exit_code == 0
    reset_logging()
    selected = runner.invoke(app, ["--env-file", str(env_file), "info"])
    reset_logging()
    default = runner.invoke(app, ["info"])

    assert selected.exit_code == 0, selected.output
    assert json.loads(selected.stderr)["event"] == "reporting project info"
    assert selected.stdout.strip() == f"{{ project_slug }} v{__version__}"
    assert default.exit_code == 0, default.output
    assert "{{ project_slug }}" in default.output
    assert default.stderr == ""


def test_cli_loads_explicit_secrets(
    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
) -> None:
    monkeypatch.chdir(tmp_path)
    secret_dir = tmp_path / "secrets"
    secret_dir.mkdir()
    (secret_dir / "LOGGING__CONSOLE_LEVEL").write_text("DEBUG", encoding="utf-8")
    (secret_dir / "LOGGING__CONSOLE_FORMAT").write_text("json", encoding="utf-8")

    result = runner.invoke(app, ["--secrets-dir", str(secret_dir), "info"])

    assert result.exit_code == 0, result.output
    assert json.loads(result.stderr)["event"] == "reporting project info"


@pytest.mark.parametrize("option", ["--env-file", "--secrets-dir"])
def test_cli_rejects_missing_config_paths(tmp_path: Path, option: str) -> None:
    result = runner.invoke(app, [option, str(tmp_path / "absent"), "info"])

    assert result.exit_code == 2


def test_version_does_not_load_invalid_settings(
    monkeypatch: pytest.MonkeyPatch,
) -> None:
    monkeypatch.setenv("LOGGING__CONSOLE_FORMAT", "invalid")

    result = runner.invoke(app, ["--version"])

    assert result.exit_code == 0
