# Every setting the application reads, as one table per settings group. Committed —
# never put a real secret in it. Copy it to config.toml and select it explicitly with
# load_settings_with_config(config_file=Path("config.toml")) or the CLI's --config
# option. Environment variables and a selected .env both override this file.

[logging]
# "text" or "json" — choose independently of the deployment environment.
format = "text"
level = "INFO"
