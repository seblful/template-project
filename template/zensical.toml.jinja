[project]
site_name = "{{ project_slug }}"
site_description = "{{ project_description }}"
site_author = "{{ author_name }}"
# Uncomment once the docs have a home; repo_name needs repo_url set alongside it.
# site_url = "https://example.github.io/{{ project_slug }}/"
# repo_url = "https://github.com/example/{{ project_slug }}"
# repo_name = "example/{{ project_slug }}"
nav = [
  { "Home" = "index.md" },
  { "Reference" = "reference.md" },
]

[project.theme]
features = ["navigation.instant", "navigation.tracking", "content.code.copy"]

[[project.theme.palette]]
media = "(prefers-color-scheme: light)"
scheme = "default"
toggle.icon = "lucide/sun"
toggle.name = "Switch to dark mode"

[[project.theme.palette]]
media = "(prefers-color-scheme: dark)"
scheme = "slate"
toggle.icon = "lucide/moon"
toggle.name = "Switch to light mode"

[project.plugins.mkdocstrings.handlers.python]
paths = ["{{ python_prefix }}src"]

[project.plugins.mkdocstrings.handlers.python.options]
docstring_style = "google"
show_source = true
show_root_heading = true
members_order = "source"
separate_signature = true
show_signature_annotations = true

[project.markdown_extensions]
admonition = {}
pymdownx.highlight = {}
# A renamed README fails the build instead of rendering an empty home page.
pymdownx.snippets.check_paths = true
pymdownx.superfences.custom_fences = [
  { name = "mermaid", class = "mermaid", format = "pymdownx.superfences.fence_code_format" },
]
toc.permalink = true
