# GitLab has no cron syntax in this file. To get the weekly dependency audit, add a
# pipeline schedule under Build > Pipeline schedules with SCHEDULED_AUDIT set to "1".

stages:
  - check
  - docs
  - audit

default:
  image: ghcr.io/astral-sh/uv:python{{ python_version }}-bookworm  # has git, for pre-commit
  interruptible: true
  cache:
    key:
      files:
        - uv.lock
    paths:
      - .cache/uv
      - .cache/pre-commit

variables:
  UV_CACHE_DIR: $CI_PROJECT_DIR/.cache/uv  # GitLab only caches paths under the project
  PRE_COMMIT_HOME: $CI_PROJECT_DIR/.cache/pre-commit
  UV_LINK_MODE: copy  # cache and venv are on different filesystems; hardlinks fail

workflow:
  rules:
    - if: $CI_PIPELINE_SOURCE == "merge_request_event"
    - if: $CI_COMMIT_BRANCH && $CI_OPEN_MERGE_REQUESTS  # avoid a duplicate MR pipeline
      when: never
    - if: $CI_COMMIT_BRANCH
    - if: $CI_COMMIT_TAG

check:
  stage: check
  script:
    - uv sync --locked  # fails on a stale lockfile instead of masking it
    # gitleaks scans staged changes, so this is not a full-history secret scan.
    - uv run pre-commit run --all-files --show-diff-on-failure
    - uv run pytest --cov --cov-report=xml --cov-report=term --junitxml=report.xml
  coverage: '/^TOTAL.*?(\d+(?:\.\d+)?)%$/'
  artifacts:
    when: always
    reports:
      junit: report.xml
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

docs:
  stage: docs
  script:
    - uv sync --locked --group docs
    - uv run mkdocs build --strict  # fails on broken refs, not holes in the built site
  artifacts:
    paths:
      - site
    expire_in: 1 week

pages:
  stage: docs
  needs:
    - docs
  script:
    - mv site public
  artifacts:
    paths:
      - public
  rules:
    # Manual: a project that starts "Private :: Do Not Upload" shouldn't auto-publish.
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      when: manual
      allow_failure: true

audit:
  stage: audit
  script:
    - uv export --format requirements-txt --no-emit-project --all-groups
      > requirements-audit.txt
    - uvx pip-audit --disable-pip --requirement requirements-audit.txt
  rules:
    - if: $SCHEDULED_AUDIT
    - if: $CI_COMMIT_BRANCH == $CI_DEFAULT_BRANCH
      allow_failure: true  # a CVE surfaces here without blocking unrelated merges
