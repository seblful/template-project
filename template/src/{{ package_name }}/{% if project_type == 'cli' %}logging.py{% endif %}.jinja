"""Structlog logging configured on top of the standard library's logging module.

Every record is routed through stdlib handlers via `ProcessorFormatter`, so that
application logs and third-party library logs (httpx, uvicorn, sqlalchemy) come out
in the same shape. The console receives human-readable text or JSON according to
`LoggingSettings.console_format`; the optional log file always receives JSON.
"""

# Lets the settings import below be type-only on every supported Python, not just on
# 3.14+, where annotations are lazy anyway; without it, 3.11-3.13 would need quotes.
from __future__ import annotations

import io
import logging
import sys
from logging.handlers import RotatingFileHandler
from typing import TYPE_CHECKING, Final

import structlog

if TYPE_CHECKING:
    from {{ package_name }}.settings import LoggingSettings

_LEVELS: Final = {
    "DEBUG": logging.DEBUG,
    "INFO": logging.INFO,
    "WARNING": logging.WARNING,
    "ERROR": logging.ERROR,
    "CRITICAL": logging.CRITICAL,
}

_MAX_LOG_BYTES: Final = 10 * 1024 * 1024
_LOG_BACKUP_COUNT: Final = 3

# Doubles as the "already configured" flag; logging.root.handlers isn't safe since
# pytest installs a capture handler around every test.
_installed: Final[list[logging.Handler]] = []

# Shared between structlog's chain and foreign_pre_chain, so library and
# application logs render identically.
_SHARED_PROCESSORS: Final = [
    structlog.contextvars.merge_contextvars,
    structlog.stdlib.add_logger_name,
    structlog.stdlib.add_log_level,
    structlog.processors.TimeStamper(fmt="iso", utc=True),
    structlog.processors.StackInfoRenderer(),
]


def get_logger(name: str | None = None) -> structlog.typing.FilteringBoundLogger:
    """Return a structlog logger, safe to call at import time before setup.

    Args:
        name: Logger name, conventionally the calling module's `__name__`.
    """
    return structlog.get_logger(name)


def _force_utf8_stderr() -> None:
    """Make console output survive a non-UTF-8 terminal, common on Windows.

    `reconfigure` mutates the existing wrapper in place. Rebinding `sys.stderr` to a
    fresh `TextIOWrapper` would leave the original free to be garbage collected,
    closing the underlying buffer out from under the replacement.
    """
    stderr = sys.stderr
    if isinstance(stderr, io.TextIOWrapper) and (stderr.encoding or "").lower() not in {
        "utf-8",
        "utf8",
    }:
        stderr.reconfigure(encoding="utf-8")


def _build_formatter(*, as_json: bool) -> logging.Formatter:
    """Build a formatter that renders structlog and stdlib records the same way."""
    render = (
        # JSONRenderer needs tracebacks pre-serialized, or exc_info comes out as `true`.
        [structlog.processors.dict_tracebacks, structlog.processors.JSONRenderer()]
        if as_json
        else [structlog.dev.ConsoleRenderer(colors=sys.stderr.isatty())]
    )
    return structlog.stdlib.ProcessorFormatter(
        foreign_pre_chain=_SHARED_PROCESSORS,
        processors=[
            structlog.stdlib.ProcessorFormatter.remove_processors_meta,
            *render,
        ],
    )


def setup_logging(settings: LoggingSettings) -> None:
    """Configure logging for the application, idempotently.

    Args:
        settings: Logging configuration supplied by the host application.
    """
    if _installed:
        return

    _force_utf8_stderr()
    console_handler = logging.StreamHandler(sys.stderr)
    console_handler.setLevel(_LEVELS[settings.console_level])
    console_handler.setFormatter(
        _build_formatter(as_json=settings.console_format == "json")
    )
    handlers: list[logging.Handler] = [console_handler]

    if settings.log_file is not None:
        file_path = settings.log_file.resolve()
        file_path.parent.mkdir(parents=True, exist_ok=True)
        # delay=True, so a command that never logs leaves no empty file behind.
        file_handler = RotatingFileHandler(
            file_path,
            maxBytes=_MAX_LOG_BYTES,
            backupCount=_LOG_BACKUP_COUNT,
            encoding="utf-8",
            delay=True,
        )
        file_handler.setLevel(_LEVELS[settings.file_level])
        file_handler.setFormatter(_build_formatter(as_json=True))
        handlers.append(file_handler)

    level = min(handler.level for handler in handlers)

    # Added, not replaced: pytest's capture handler and any host handlers keep working.
    root = logging.getLogger()
    root.setLevel(level)
    for handler in handlers:
        root.addHandler(handler)
    _installed.extend(handlers)

    structlog.configure(
        processors=[
            *_SHARED_PROCESSORS,
            structlog.stdlib.ProcessorFormatter.wrap_for_formatter,
        ],
        # Drop events below every handler threshold before they are ever formatted.
        wrapper_class=structlog.make_filtering_bound_logger(level),
        logger_factory=structlog.stdlib.LoggerFactory(),
        cache_logger_on_first_use=True,
    )


def reset_logging() -> None:
    """Detach everything `setup_logging` installed and reset structlog.

    Closing the file handler matters on Windows, where an open handle blocks the
    directory from being removed, which is exactly what `tmp_path` teardown does.
    """
    root = logging.getLogger()
    for handler in _installed:
        root.removeHandler(handler)
        handler.close()
    _installed.clear()
    structlog.reset_defaults()
