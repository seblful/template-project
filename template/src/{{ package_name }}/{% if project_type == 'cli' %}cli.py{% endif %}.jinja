"""Command line interface for {{ project_slug }}."""

from dataclasses import dataclass
from pathlib import Path
from typing import Annotated

import typer

from {{ package_name }} import PROJECT_NAME, __version__
{%- if config_file %}
from {{ package_name }}.config_file import load_settings_with_config
{%- endif %}
from {{ package_name }}.logging import get_logger, setup_logging
from {{ package_name }}.settings import Settings{% if not config_file %}, load_settings{% endif %}

app = typer.Typer(help=f"{PROJECT_NAME} CLI", no_args_is_help=True)


@dataclass(frozen=True)
class GlobalOptions:
    """Options given before the subcommand, applied when the command body runs.

    Loading lives here rather than in the callback because Click runs the callback
    before it parses the subcommand, so `info --help` would otherwise read and
    validate configuration just to print help.
    """

    env_file: Path | None
{%- if config_file %}
    config_file: Path | None

    def configure(self) -> Settings:
        """Load settings, set up logging and return the settings."""
        settings = load_settings_with_config(
            config_file=self.config_file, env_file=self.env_file
        )
{%- else %}

    def configure(self) -> Settings:
        """Load settings, set up logging and return the settings."""
        settings = load_settings(env_file=self.env_file)
{%- endif %}
        setup_logging(settings.logging)
        return settings


def _version_callback(value: bool) -> None:
    """Print the version and exit, before any subcommand is resolved."""
    if value:
        typer.echo(f"{PROJECT_NAME} {__version__}")
        raise typer.Exit


@app.callback()
def main(
    ctx: typer.Context,
    env_file: Annotated[
        Path | None,
        typer.Option(
            exists=True, dir_okay=False, readable=True, help="Load a dotenv file."
        ),
    ] = None,
{%- if config_file %}
    config_file: Annotated[
        Path | None,
        typer.Option(
            "--config",
            exists=True,
            dir_okay=False,
            readable=True,
            help="Load a TOML config file.",
        ),
    ] = None,
{%- endif %}
    _version: Annotated[
        bool,
        typer.Option(
            "--version",
            callback=_version_callback,
            is_eager=True,  # else no_args_is_help resolves first, before --version runs
            help="Show the version and exit.",
        ),
    ] = False,
) -> None:
    """Run the {{ project_slug }} CLI."""
    ctx.obj = GlobalOptions(env_file=env_file{% if config_file %}, config_file=config_file{% endif %})


@app.command()
def info(ctx: typer.Context) -> None:
    """Display project information."""
    ctx.obj.configure()
    get_logger(__name__).debug("reporting project info")
    typer.echo(f"{PROJECT_NAME} v{__version__}")


if __name__ == "__main__":
    app()
