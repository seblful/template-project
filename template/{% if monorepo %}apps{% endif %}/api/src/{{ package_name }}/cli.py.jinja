"""Command line interface for {{ project_slug }}: serve the API or export its schema."""

import json
from pathlib import Path
from typing import Annotated

import typer
import uvicorn

from {{ package_name }} import PROJECT_NAME, __version__
from {{ package_name }}.app import create_app
from {{ package_name }}.logging import setup_logging
from {{ package_name }}.settings import load_settings

app = typer.Typer(help=f"{PROJECT_NAME} CLI", no_args_is_help=True)


def _version_callback(value: bool) -> None:
    """Print the version and exit, before any subcommand is resolved."""
    if value:
        typer.echo(f"{PROJECT_NAME} {__version__}")
        raise typer.Exit


@app.callback()
def main(
    _version: Annotated[
        bool,
        typer.Option(
            "--version",
            callback=_version_callback,
            is_eager=True,  # else no_args_is_help resolves first, before --version runs
            help="Show the version and exit.",
        ),
    ] = False,
) -> None:
    """Run the {{ project_slug }} CLI."""


@app.command()
def serve(
    env_file: Annotated[
        Path | None,
        typer.Option(
            exists=True, dir_okay=False, readable=True, help="Load a dotenv file."
        ),
    ] = None,
    host: Annotated[str, typer.Option(help="Interface to bind.")] = "127.0.0.1",
    port: Annotated[int, typer.Option(help="Port to bind.")] = 8000,
) -> None:
    """Serve the API with uvicorn."""
    settings = load_settings(env_file=env_file)
    setup_logging(settings.logging)
    # log_config=None stops uvicorn from replacing the handler setup_logging installed,
    # so its access and error logs come out in the application's format.
    uvicorn.run(create_app(), host=host, port=port, log_config=None)


@app.command()
def openapi() -> None:
    """Print the OpenAPI schema, the contract API clients are generated from."""
    typer.echo(json.dumps(create_app().openapi(), indent=2))
