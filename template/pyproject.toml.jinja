[project]
name = "{{ project_slug }}"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
version = "0.1.0"
{% if license == "MIT" %}
license = "MIT"
license-files = ["LICENSE"]
{% elif license == "Apache" %}
license = "Apache-2.0"
license-files = ["LICENSE"]
{% endif %}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
classifiers = [
{%- if not publish %}
    "Private :: Do Not Upload",  # PyPI rejects any upload that carries this classifier
{%- endif %}
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: {{ python_version }}",
    "Typing :: Typed",
]
{%- if application %}
dependencies = [
{%- if project_type == "api" %}
    "fastapi>=0.143.0",
    "uvicorn>=0.54.0",
{%- endif %}
    "typer>=0.12.0",
    "structlog>=24.1.0",
    "pydantic>=2.7.0",
    "pydantic-settings>=2.14.2",
]
{%- else %}
# Every dependency is forced on each consumer: add one only when the package cannot
# work without it, and never with an upper bound.
dependencies = []
{%- endif %}
{% if application %}
[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:app"
{% endif %}
# ty and prek are pre-1.0: breaking changes land between patch releases.
[dependency-groups]
dev = [
    "pytest>=9.0.0,<10",
    "pytest-cov>=7.0.0,<8",
    "ruff>=0.17.0,<0.18",
    "mdformat>=1.0.0,<2",
    "ty>=0.0.28,<0.1",
    "prek>=0.5.5,<0.6",
{%- if project_type == "api" %}
    "httpx2>=2.13.1,<3",  # what FastAPI's TestClient sends its requests through
{%- endif %}
]

[build-system]
requires = ["uv_build>=0.13.0,<0.14"]  # capped, as uv recommends
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = "{{ package_name }}"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-ra --strict-markers --strict-config"
xfail_strict = true

[tool.ruff.lint]
select = [
    "E",    # pycodestyle errors
    "F",    # Pyflakes
    "W",    # pycodestyle warnings
    "I",    # isort
    "B",    # flake8-bugbear
    "UP",   # pyupgrade
    "SIM",  # flake8-simplify
    "RUF",  # Ruff-specific
    "PT",   # flake8-pytest-style
]
# Worth adding as the code base grows: A, ANN, ARG, ASYNC, BLE, C4, C90, D, DTZ, ERA,
# FURB, G, INP, LOG, N, PERF, PL, PTH, RET, S, SLF, TC, TID, TRY.

[tool.ruff.format]
line-ending = "lf"

[tool.coverage.run]
source = ["src/{{ package_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
exclude_also = [
    "if __name__ == .__main__.:",
    "raise NotImplementedError",
    "@(abc\\.)?abstractmethod",
]
