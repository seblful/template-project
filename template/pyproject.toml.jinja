[project]
name = "{{ project_slug }}"
description = "{{ project_description }}"
readme = "README.md"
requires-python = ">={{ python_version }}"
version = "0.1.0"
{% if license == "MIT" %}
license = "MIT"
license-files = ["LICENSE"]
{% elif license == "Apache" %}
license = "Apache-2.0"
license-files = ["LICENSE"]
{% endif %}
authors = [
    { name = "{{ author_name }}", email = "{{ author_email }}" }
]
classifiers = [
{%- if license == "None" %}
    "Private :: Do Not Upload",  # unregistered on purpose: PyPI rejects any such upload
{%- endif %}
    "Development Status :: 3 - Alpha",
    "Intended Audience :: Developers",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: {{ python_version }}",
    "Typing :: Typed",
]
# Uncapped: an upper bound here propagates to everyone installing this package.
dependencies = [
{%- if project_type == "cli" %}
    "typer>=0.12.0",
{%- endif %}
    "structlog>=24.1.0",
    "pydantic>=2.7.0",
    "pydantic-settings>=2.2.0",
]
{% if project_type == "cli" %}
[project.scripts]
{{ project_slug }} = "{{ package_name }}.cli:app"
{% endif %}
[dependency-groups]
dev = [
    "pytest>=9.0.0,<10",
    "pytest-cov>=7.0.0,<8",
    "pytest-randomly>=4.0.0,<5",  # catches order-dependence from shared module state
    "ruff>=0.15.10,<0.16",
    "mdformat>=1.0.0,<2",
    "ty>=0.0.28,<0.1",  # pre-1.0: breaking changes land between patch releases
    "pre-commit>=4.0.0,<5",
]
docs = [  # a group, not an extra: docs tooling isn't a feature of the installed package
    # <2 is load-bearing: MkDocs 2.0 drops the plugin system material/mkdocstrings need
    "mkdocs>=1.6.0,<2",
    "mkdocs-material>=9.5.0,<10",
    "mkdocstrings[python]>=0.25.0,<2",
]

[build-system]
requires = ["hatchling>=1.27"]  # floor for PEP 639's `license` and `license-files`
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.pytest.ini_options]
testpaths = ["tests"]
# No --cov-fail-under here: a partial run (a single file, or -k) would then report
# false-low coverage. Measure explicitly: `uv run pytest --cov` (see [tool.coverage]).
addopts = "-ra --strict-markers --strict-config"
xfail_strict = true
# A DeprecationWarning from a dependency is a scheduled outage; catch it here. If one
# is genuinely not actionable, narrow it with `ignore:<msg>:<category>:<module>` rather
# than dropping "error" entirely.
filterwarnings = ["error"]
markers = [
    "integration: tests that hit real I/O (DB, filesystem, network)",
    "slow: tests that take more than a second",
]

[tool.ruff]
# No target-version: ruff infers it from requires-python.
line-length = 88
src = ["src"]

[tool.ruff.lint]
# COM/ISC001/Q are absent: the formatter already owns commas, quotes and string joins,
# and ruff's own COM812 docs advise against pairing it with the formatter.
select = [
    "A",     # flake8-builtins — shadowed builtins
    "ANN",   # flake8-annotations — py.typed is a promise; this makes annotations exist
    "ARG",   # flake8-unused-arguments
    "ASYNC", # flake8-async
    "B",     # flake8-bugbear
    "BLE",   # flake8-blind-except
    "C4",    # flake8-comprehensions
    "C90",   # mccabe — complexity ceiling (max-complexity defaults to 10)
    "D",     # pydocstyle — enforce Google-style docstrings
    "DTZ",   # flake8-datetimez — naive datetimes are a production bug class
    "E",     # pycodestyle errors
    "ERA",   # eradicate — commented-out code
    "F",     # Pyflakes
    "FLY",   # flynt — static string joins
    "FURB",  # refurb — modernization (40 stable rules; the rest need preview)
    "G",     # flake8-logging-format — no f-strings in log calls
    "I",     # isort
    "INP",   # flake8-no-pep420 — missing __init__.py
    "LOG",   # flake8-logging — stdlib logging misuse
    "N",     # pep8-naming
    "PERF",  # perflint
    "PGH",   # pygrep-hooks — blanket `type: ignore`, bare `noqa`
    "PIE",   # flake8-pie
    "PL",    # Pylint rules
    "PT",    # flake8-pytest-style
    "PTH",   # flake8-use-pathlib
    "RET",   # flake8-return
    "RSE",   # flake8-raise
    "RUF",   # Ruff-specific (incl. RUF100, which flags stale noqa)
    "S",     # flake8-bandit — security checks
    "SIM",   # flake8-simplify
    "SLF",   # flake8-self — private member access
    "TC",    # flake8-type-checking
    "TID",   # flake8-tidy-imports
    "TRY",   # tryceratops — exception antipatterns
    "UP",    # pyupgrade
    "W",     # pycodestyle warnings
]
# No `ignore` list: prefer `# noqa: X` at the site, or per-file-ignores below.

[tool.ruff.lint.pydocstyle]
convention = "google"
{% if project_type == "cli" %}
[tool.ruff.lint.flake8-bugbear]
extend-immutable-calls = ["typer.Argument", "typer.Option"]
{% endif %}
[tool.ruff.lint.flake8-tidy-imports]
ban-relative-imports = "all"

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]

[tool.ruff.lint.per-file-ignores]
# Tests don't need docstrings, may use asserts, magic values, and unused fixture args.
"tests/**" = ["D", "S101", "PLR2004", "ARG"]

[tool.ruff.format]
# Format code inside docstring examples, since the google convention invites them.
docstring-code-format = true
line-ending = "lf"

[tool.ty.src]
exclude = ["notebooks", "scripts"]  # not created by the template; ad-hoc code goes here

[tool.coverage.run]
source = ["src/{{ package_name }}"]
# branch = true  # enable once the suite covers both sides of conditionals

[tool.coverage.report]
show_missing = true
fail_under = 80
exclude_also = [
    "if __name__ == .__main__.:",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
    "@(abc\\.)?abstractmethod",
]
