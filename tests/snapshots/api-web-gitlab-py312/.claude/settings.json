{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "$comment": [
    "Committed, project-scoped rules only. Machine-local overrides go in .claude/settings.local.json, which is gitignored.",
    "allow names exact commands, never `uv *`: `uv run` executes whatever follows it, so a broad rule would auto-approve `uv run rm -rf .` past every deny rule. Deny rules are guardrails, not a boundary: for enforcement, turn on the sandbox with /sandbox.",
    "Read(!.env.example) carves the committed contract back out of Read(.env.*); an allow rule couldn't, because deny always wins."
  ],
  "permissions": {
    "allow": [
      "Bash(uv sync *)",
      "Bash(uv lock *)",
      "Bash(uv tree *)",
      "Bash(uv run pytest *)",
      "Bash(uv run ruff *)",
      "Bash(uv run ty *)",
      "Bash(uv run mdformat *)",
      "Bash(uv run prek run *)",
      "Bash(uv run prek install *)",
      "Bash(bun install --cwd web --frozen-lockfile)",
      "Bash(bun run --cwd web check)",
      "Bash(bun run --cwd web typecheck)",
      "Bash(bun run --cwd web test *)",
      "Bash(bun run --cwd web build)",
      "Bash(bun run --cwd web dev)",
      "Bash(bun run --cwd web generate)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git switch -c *)",
      "Bash(git checkout -b *)",
      "Bash(git restore --staged *)"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push * --force)",
      "Bash(git push * --force *)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git commit *--no-verify*)",
      "Bash(uv publish *)",
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(secrets/**)",
      "Read(credentials/**)",
      "Read(**/*.pem)",
      "Read(**/*.key)"
    ]
  }
}
