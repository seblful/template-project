# The delta over .gitignore: committed paths, or ones .gitignore un-ignores, that
# still have no business in an assistant's context.

.env
.env.*
!.env.example

# Committed, generated, thousands of lines long. Comments get their own line: in this
# syntax a trailing `# ...` is part of the pattern, not a comment.
uv.lock
bun.lock
routeTree.gen.ts
src/api/

# Belt and suspenders: .gitignore covers these too, but a leaked key stays unindexed.
*.key
*.pem
secrets/
credentials/
.ssh/
