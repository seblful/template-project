# Every key the application reads, with safe placeholder values. Committed, so never
# put a real secret here. Copy it to a gitignored .env and load that file with
# `uv run --env-file .env`.

# Logging Settings
# text | json
DEMO_PROJ_LOGGING__FORMAT=text
# DEBUG | INFO | WARNING | ERROR | CRITICAL, in any letter case
DEMO_PROJ_LOGGING__LEVEL=INFO
